{
  "name": "medlock",
  "version": "0.2.0",
  "description": "A Streamable HTTP MCP server and site for privacy-preserving personal health data access.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22.7.5"
  },
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun dist/server.js",
    "build": "bun run tools/build.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "bun run tools/lint.ts",
    "format": "bun run tools/format.ts --write",
    "format:check": "bun run tools/format.ts --check",
    "hooks:install": "git config core.hooksPath .githooks",
    "verify": "bun ci --no-env-file --ignore-scripts --registry=https://registry.npmjs.org && bun --no-env-file run verify:ci",
    "verify:ci": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build",
    "verify:ttl": "bun run tools/verify-ttl.ts"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.7",
    "jose": "6.2.13"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/bun": "1.4.3",
    "typescript": "7.0.2",
    "firebase-admin": "14.5.0",
    "rate-limiter-flexible": "11.2.3"
  }
}
